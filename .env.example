# Copy to .env for local development. NEVER commit .env or a real connection string.

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Local default is SQLite. For Neon, paste the connection string from the Neon
# console (see docs/NEON.md). In Render, set this as an environment variable
# in the dashboard instead of putting it in a file.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

LLM_PROVIDER=mock

# Public signup stays off until the protections are verified.
SIGNUP_ENABLED=false

# Free-tier budget (Neon Free is about 0.5 GB per project; confirm current limits).
DB_STORAGE_LIMIT_MB=400
MAX_UPLOAD_MB=5
MAX_LINES_PER_UPLOAD=50000
MAX_LOG_ENTRIES_PER_WORKSPACE=100000
LOG_RETENTION_DAYS=14

# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# DEMO_USERNAME=
# DEMO_PASSWORD=
